{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${mod_url}",
    "issues": "${mod_issues}"
  },
  "license": "${mod_license}",
  "icon": "${mod_id}.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.rinkynooble.taczadastrafix.fabric.TaczAdAstraFixFabric"]
  },
  "mixins": ["${mod_id}.mixins.json"],
  "depends": {
    "fabricloader": "${fabric_loader_range}",
    "minecraft": "${fabric_minecraft_range}",
    "java": ">=21",
    "ad_astra": "${fabric_ad_astra_range}"
  }
}
